# Funding mode: local | testnet
# local  — fake bankroll seed, anvil/MockUSDC, no Rain ACH (default dev/CI)
# testnet — Rain sandbox (RAIN_*) + Monad testnet (MONAD_RPC_URL)
FUNDING_MODE=local

# Local-only: seed fake agent bankroll in Postgres (ignored when FUNDING_MODE=testnet)
SEED_BANKROLL_USDC=1000

# Agent HTTP auth — backend issues per agent; paste into agent runtime (NOT human browser login)
# AGENT_API_KEY=

# Platform signer — one key signs all on-chain txs. Never commit real keys.
# Local default = public anvil account #0 (FUNDING_MODE=local only).
PLATFORM_SIGNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PLATFORM_SIGNER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Deployed contracts (just deploy-local prints + writes these for local; testnet = deployed addresses)
# MockUSDC when FUNDING_MODE=local; real/testnet USDC when testnet
SUBWAY_MARKET_ADDRESS=
USDC_ADDRESS=


# Broker
NATS_URL=nats://127.0.0.1:4223

# Ledger Postgres (docker-compose default)
DATABASE_URL=postgres://subway:subway@127.0.0.1:5433/subway_ledger

# Logging
# Levels: error > warn > info > debug
RUST_LOG=info,async_nats=warn,diesel=warn
# Default unset / json = lnav-friendly JSON lines on `just start`.
# Use pretty/text for solo foreground (`just ingest`, etc.).
# LOG_FORMAT=pretty

# Ready-file gate timeout (seconds) for `just start`
READY_TIMEOUT=180

# Monad RPC (contracts / chain lane)
# local: anvil default; testnet: Monad testnet RPC URL
MONAD_RPC_URL=http://127.0.0.1:8545
# Optional; empty ok for local (foundry.toml etherscan placeholder)
MONAD_ETHERSCAN_KEY=

# Frontend → backend (each app has its own PORT when run solo; defaults: backend 8080, frontend 3000)
# BACKEND_URL=http://127.0.0.1:8080

# Rain (Raingentic Commerce Hackathon) — used only when FUNDING_MODE=testnet
# Sandbox docs: https://rain-sandbox-trial.mintlify.site/reference/rain-api
# Auth header: Api-Key: $RAIN_API_KEY
# E2E 3 go-time acceptance requires all RAIN_* below set; skip E2E 3 + report if missing
RAIN_API_BASE_URL=https://api-dev.raincards.xyz/v1
RAIN_TEAM_ID=
RAIN_USER_ID=
RAIN_API_KEY=
RAIN_COLLATERAL_CONTRACT_ID=
